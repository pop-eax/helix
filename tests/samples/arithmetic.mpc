// Complex arithmetic operations
fn compute(Public Field<9223372036854775807> a, Public Field<9223372036854775807> b, Public Field<9223372036854775807> c) -> Field<9223372036854775807> {
    let Public Field<9223372036854775807> temp = a * b;
    let Public Field<9223372036854775807> result = temp + c;
    return result;
}

